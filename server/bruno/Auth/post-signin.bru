meta {
  name: Sign In
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/signin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "tno@example.com",
    "password": "12345678"
  }
}

script:post-response {
  // Store accessToken and refreshToken cookies from Set-Cookie headers for subsequent requests
  const jar = bru.cookies.jar();
  const cookieUrl = (bru.getEnvVar('baseUrl') || 'http://localhost:5000/api').replace(/\/api\/?$/, '') || 'http://localhost:5000';
  const setCookie = res.headers['set-cookie'] || res.headers['Set-Cookie'];
  if (setCookie) {
    const cookies = Array.isArray(setCookie) ? setCookie : [setCookie];
    cookies.forEach(function(cookieStr) {
      const parts = cookieStr.split(';')[0].split('=');
      const name = parts[0].trim();
      const value = parts.slice(1).join('=').trim();
      if (name === 'accessToken' || name === 'refreshToken') {
        jar.setCookie(cookieUrl, name, value);
      }
    });
  }
}
