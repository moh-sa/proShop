{
	"name": "server",
	"version": "1.0.0",
	"description": "Server for the e-commerce platform",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"build": "tsc",
		"data:destroy": "node seeder -d",
		"data:import": "node seeder",
		"dev": "ts-node src/server.ts",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint . --max-warnings=0",
		"lint:check": "eslint . --max-warnings=0 --format=stylish",
		"lint:fix": "eslint . --fix --max-warnings=0",
		"start": "node dist/server.js",
		"test": "glob -c \"tsx --test --test-reporter spec\" \"./src/tests/**/*.test.ts\"",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@sentry/node": "^8.54.0",
		"@sentry/profiling-node": "^8.54.0",
		"@typescript-eslint/typescript-estree": "^8.39.0",
		"argon2": "^0.44.0",
		"bcryptjs": "^2.4.3",
		"cloudinary": "^2.6.0",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"express-async-handler": "^1.2.0",
		"jsonwebtoken": "^9.0.2",
		"mongodb-memory-server": "^10.1.3",
		"mongoose": "^6.7.5",
		"morgan": "^1.10.0",
		"multer": "^1.4.5-lts.1",
		"node-cache": "^5.1.2",
		"node-mocks-http": "^1.16.2",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@faker-js/faker": "^9.4.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/morgan": "^1.9.9",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.10.1",
		"@types/supertest": "^6.0.3",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^17.21.3",
		"eslint-plugin-package-json": "^0.52.1",
		"eslint-plugin-perfectionist": "^4.15.0",
		"glob": "^11.0.1",
		"globals": "^16.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-curly": "^0.3.2",
		"prettier-plugin-packagejson": "^2.5.19",
		"supertest": "^7.1.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.39.0"
	},
	"engines": {
		"node": "22.13.1",
		"npm": "10.9.2"
	}
}
