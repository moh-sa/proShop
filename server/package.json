{
	"name": "server",
	"version": "1.0.0",
	"private": true,
	"description": "Server for the e-commerce platform",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "cross-env NODE_ENV=development tsx watch --import ./src/config/sentry.config.ts src/server.ts | pino-pretty",
		"dev:debug": "cross-env NODE_ENV=development tsx watch --inspect src/server.ts | pino-pretty",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint . --max-warnings=0",
		"lint:check": "eslint . --max-warnings=0 --format=stylish",
		"lint:fix": "eslint . --fix --max-warnings=0",
		"start": "cross-env NODE_ENV=production node --import ./dist/config/sentry.config.js dist/server.js",
		"test": "cross-env NODE_ENV=test tsx --test --test-reporter spec src/tests/**/*.test.ts",
		"test:debug": "cross-env NODE_ENV=test tsx --test --test-reporter spec --inspect src/tests/**/*.test.ts",
		"test:integration": "cross-env NODE_ENV=test tsx --test --test-reporter spec src/tests/integration/*.integration.test.ts",
		"test:unit": "cross-env NODE_ENV=test tsx --test --test-reporter spec src/tests/unit/*.unit.test.ts",
		"type-check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@sentry/node": "^8.54.0",
		"argon2": "^0.44.0",
		"cloudinary": "^2.6.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"express-mongo-sanitize": "^2.2.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^9.2.4",
		"multer": "^2.1.1",
		"node-cache": "^5.1.2",
		"pino": "^10.1.0",
		"pino-http": "^11.0.0",
		"stripe": "^20.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@faker-js/faker": "^10.3.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/multer": "^2.1.0",
		"@types/node": "^22.10.1",
		"@types/supertest": "^7.2.0",
		"cross-env": "^10.0.0",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^17.21.3",
		"eslint-plugin-package-json": "^0.91.1",
		"eslint-plugin-perfectionist": "^4.15.0",
		"globals": "^16.3.0",
		"mongodb-memory-server": "^10.1.3",
		"node-mocks-http": "^1.16.2",
		"pino-pretty": "^13.1.2",
		"prettier": "^3.6.2",
		"prettier-plugin-curly": "^0.3.2",
		"supertest": "^7.2.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.39.0"
	},
	"engines": {
		"node": "^22"
	}
}
